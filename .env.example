# Public site URL, used for canonical URLs, the sitemap and OG image URLs.
#
# Must be the WWW host, because that is the domain Vercel serves as primary —
# the bare apex 308s to it. If these two ever disagree, the sitemap lists URLs
# on a host it is not served from and Google rejects it ("Couldn't fetch").
# No trailing slash. src/lib/site.ts adds the www back if it is missing here.
NEXT_PUBLIC_SITE_URL=https://www.letsbreathein.fit

# Contact address shown on /contact. Defaults to the address in src/lib/site.ts;
# set this only if you want to override it per environment.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense publisher ID. Leave EMPTY until AdSense approves the site.
# When empty, no ad script loads and no ad containers render.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit slot IDs from your AdSense dashboard (optional, per placement)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_SESSION=
